<Application x:Class="PixelWorkspace.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Accent" Color="#287F7A"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#FFFEFA"/><Setter Property="Foreground" Value="#46666A"/><Setter Property="BorderBrush" Value="#CBDAD5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="34"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#287F7A"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.38"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="9,6"/><Setter Property="Margin" Value="4"/><Setter Property="BorderBrush" Value="#CBDAD5"/><Setter Property="Foreground" Value="#20343A"/><Setter Property="Background" Value="#FFFEFA"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Frame" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="{TemplateBinding Background}"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#287F7A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="4"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="#46666A"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="6"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="#46666A"/></Style>
  <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#46666A"/></Style>
  <Style TargetType="Slider"><Setter Property="Foreground" Value="#287F7A"/></Style>
  <Style TargetType="ContextMenu"><Setter Property="Background" Value="#FFFEFA"/><Setter Property="BorderBrush" Value="#CBDAD5"/><Setter Property="Padding" Value="5"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="MenuItem"><Setter Property="Padding" Value="12,7"/><Setter Property="Foreground" Value="#46666A"/></Style>
  <Style TargetType="ToolTip"><Setter Property="MaxWidth" Value="420"/><Setter Property="Background" Value="#FFFEFA"/><Setter Property="Foreground" Value="#46666A"/><Setter Property="Padding" Value="10,7"/><Setter Property="BorderBrush" Value="#CBDAD5"/></Style>
 </Application.Resources>
</Application>
